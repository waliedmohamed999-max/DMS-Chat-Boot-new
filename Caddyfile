# شهادة SSL تلقائية بالكامل عبر Let's Encrypt — Caddy بيطلبها ويجدّدها لوحده، مفيش أي إعداد يدوي
# مطلوب غير إن DOMAIN يكون فعلاً بيشاور على IP السيرفر ده (سجل DNS من نوع A) قبل أول تشغيل.
{$DOMAIN} {
	reverse_proxy app:3000

	encode gzip

	header {
		# رؤوس الأمان الأساسية مكرَّرة أصلاً في next.config.js (HSTS/CSP/إلخ) — Caddy هنا فقط بروكسي
		# شفاف، ما بيضيفش رؤوساً إضافية عمداً حتى لا تتعارض/تتكرر مع رؤوس التطبيق نفسه.
		-Server
	}
}
