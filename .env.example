# قاعدة البيانات
# DATABASE_URL: دور تشغيلي محدود الصلاحية (app_runtime) بدون تجاوز RLS — يُستخدم من التطبيق نفسه.
DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:55432/wa_crm?schema=public"
# DIRECT_URL: دور superuser — يُستخدم فقط من prisma migrate/db push، وليس من كود التطبيق أبداً.
DIRECT_URL="postgresql://wa_crm:wa_crm_dev_password@localhost:55432/wa_crm?schema=public"
# SUPER_ADMIN_DATABASE_URL: دور BYPASSRLS (وليس superuser) يُستخدم حصراً من lib/db.ts -> superAdminDb
# لاستعلامات لوحة Super Admin المجمّعة عبر كل المستأجرين. لا يُستخدم أبداً من أي كود خاص بمساحة تاجر واحد.
SUPER_ADMIN_DATABASE_URL="postgresql://app_superadmin:app_superadmin_dev_password@localhost:55432/wa_crm?schema=public"

# مفتاح التشفير لبيانات التكاملات الحساسة (Meta/Zid/Salla tokens) — 32 بايت
ENCRYPTION_KEY="change-me-generate-with-openssl-rand-base64-32"

# Redis (قوائم الانتظار)
REDIS_URL="redis://localhost:56379"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# وضع التكاملات: sandbox (افتراضي، بيانات وهمية واقعية) أو live (مفاتيح حقيقية)
INTEGRATIONS_MODE="sandbox"

# Meta WhatsApp Cloud API (اتركها فارغة لتشغيل sandbox mode)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="dev-verify-token"

# زد (Zid)
ZID_CLIENT_ID=""
ZID_CLIENT_SECRET=""
ZID_WEBHOOK_SECRET=""

# سلة (Salla)
SALLA_CLIENT_ID=""
SALLA_CLIENT_SECRET=""
SALLA_WEBHOOK_SECRET=""
# رقم تطبيق DMS في بوابة شركاء سلة — يفعّل الربط بالنمط السهل (رابط التثبيت s.salla.sa/apps/install/<id>)
SALLA_APP_ID=""
# سر توقيع طلبات دوال "خطوات تثبيت التطبيق" في سلة إلى /api/salla/onboarding — openssl rand -hex 32 (راجع docs/SALLA_APP_SETUP.md)
SALLA_FUNCTIONS_SECRET=""

# مزود الدفع (mock افتراضياً)
PAYMENT_PROVIDER="mock"
# سر التحقق من توقيع Webhook بوابة الدفع — فارغ = رفض كل الطلبات الواردة (fail closed)، حتى في
# وضع Sandbox. اضبطه لاختبار محاكاة webhook محلياً فقط.
PAYMENT_WEBHOOK_SECRET=""

# البريد الإلكتروني: console (افتراضي، يطبع الرسائل في سجل الخادم فقط) أو smtp (إرسال فعلي)
# مثال بريد Hostinger: SMTP_HOST="smtp.hostinger.com" SMTP_PORT="465"
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DMS <no-reply@example.com>"

# الموظف الذكي (AI Smart Employee)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
